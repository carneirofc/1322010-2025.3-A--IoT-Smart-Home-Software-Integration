{
  "name": "iot-smart-home-software-integration",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter prototype dev",
    "build:prototype": "pnpm --filter prototype build",
    "diagrams": "relatorio/scripts/diagrams.sh",
    "screens": "node relatorio/scripts/screens.mjs",
    "report": "pnpm diagrams && pnpm screens && make -C relatorio"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "12.2.0",
    "puppeteer-core": "25.17.0"
  }
}
